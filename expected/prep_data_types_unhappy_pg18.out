/* Test case: unhappy path - Unsupported data types (preparation) - PostgreSQL 18 */
-- Date/Time Types - date
--- Test setup: DDL of the Tsurugi
SELECT tg_execute_ddl('
  CREATE TABLE fdw_type_date (c DATE)
', 'tsurugidb');
 tg_execute_ddl 
----------------
 CREATE TABLE
(1 row)

--- Test setup: DDL of the PostgreSQL
CREATE FOREIGN TABLE fdw_type_date (
  c date
) SERVER tsurugidb;
--- Test
SET DATESTYLE TO 'default';
PREPARE prep_insert AS
  INSERT INTO fdw_type_date VALUES (date '01:02:03.456');
ERROR:  invalid input syntax for type date: "01:02:03.456"
LINE 2:   INSERT INTO fdw_type_date VALUES (date '01:02:03.456');
                                                 ^
PREPARE prep_insert AS
  INSERT INTO fdw_type_date VALUES (time '01:02:03.456');
ERROR:  column "c" is of type date but expression is of type time without time zone
LINE 2:   INSERT INTO fdw_type_date VALUES (time '01:02:03.456');
                                                 ^
HINT:  You will need to rewrite or cast the expression.
PREPARE prep_insert AS
  INSERT INTO fdw_type_date VALUES (date '2021-02-30');
ERROR:  date/time field value out of range: "2021-02-30"
LINE 2:   INSERT INTO fdw_type_date VALUES (date '2021-02-30');
                                                 ^
PREPARE prep_insert AS
  INSERT INTO fdw_type_date VALUES (date 'invalid');
ERROR:  invalid input syntax for type date: "invalid"
LINE 2:   INSERT INTO fdw_type_date VALUES (date 'invalid');
                                                 ^
SET DATESTYLE TO ISO, YMD;
PREPARE prep_insert (date) AS
  INSERT INTO fdw_type_date VALUES ($1);
EXECUTE prep_insert (date '1/8/1999');
ERROR:  date/time field value out of range: "1/8/1999"
LINE 1: EXECUTE prep_insert (date '1/8/1999');
                                  ^
HINT:  Perhaps you need a different "DateStyle" setting.
EXECUTE prep_insert (date '1/18/1999');
ERROR:  date/time field value out of range: "1/18/1999"
LINE 1: EXECUTE prep_insert (date '1/18/1999');
                                  ^
HINT:  Perhaps you need a different "DateStyle" setting.
EXECUTE prep_insert (date '08-Jan-99');
ERROR:  date/time field value out of range: "08-Jan-99"
LINE 1: EXECUTE prep_insert (date '08-Jan-99');
                                  ^
HINT:  Perhaps you need a different "DateStyle" setting.
EXECUTE prep_insert (date 'Jan-08-99');
ERROR:  date/time field value out of range: "Jan-08-99"
LINE 1: EXECUTE prep_insert (date 'Jan-08-99');
                                  ^
HINT:  Perhaps you need a different "DateStyle" setting.
EXECUTE prep_insert (date 'January 8, 99 BC');
ERROR:  date/time field value out of range: "January 8, 99 BC"
LINE 1: EXECUTE prep_insert (date 'January 8, 99 BC');
                                  ^
HINT:  Perhaps you need a different "DateStyle" setting.
DEALLOCATE prep_insert;
SET DATESTYLE TO 'default';
--- Test teardown: DDL of the PostgreSQL
DROP FOREIGN TABLE fdw_type_date;
--- Test teardown: DDL of the Tsurugi
SELECT tg_execute_ddl('DROP TABLE fdw_type_date', 'tsurugidb');
 tg_execute_ddl 
----------------
 DROP TABLE
(1 row)

