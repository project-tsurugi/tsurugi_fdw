-- Set up some simple test tables
SELECT tg_execute_ddl('
    CREATE TABLE subselect_tbl (
        f1 integer,
        f2 integer,
        f3 float
    )
', 'tsurugidb');
  tg_execute_ddl   
-------------------
 execute succeeded
(1 row)

CREATE FOREIGN TABLE SUBSELECT_TBL (
  f1 integer,
  f2 integer,
  f3 float
) SERVER tsurugidb;
