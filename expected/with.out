    VALUES(1,ARRAY[]::integer[])
UNION ALL
    SELECT tsurugifdw_tree.id, t.path || tsurugifdw_tree.id
    FROM tsurugifdw_tree JOIN t ON (tsurugifdw_tree.parent_id = t.id)
)
