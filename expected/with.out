	select *, false, array[row(g.f, g.t)] from tsurugifdw_graph g
	union distinct
	select g.*, row(g.f, g.t) = any(path), path || row(g.f, g.t)
	from tsurugifdw_graph g, search_graph sg
	where g.f = sg.t and not is_cycle
)
