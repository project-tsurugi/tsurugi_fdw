	select * from tsurugifdw_graph g
	union all
	select g.*
	from tsurugifdw_graph g, search_graph sg
	where g.f = sg.t
) cycle f, t set is_cycle using path
select * from search_graph ORDER BY f, t;
 f | t | label | is_cycle | path 
